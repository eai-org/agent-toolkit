{
  "schemaVersion": 2,
  "name": "eai-org/agent-toolkit",
  "version": "0.1.0",
  "provides": [
    {
      "type": "rules",
      "path": "rules",
      "format": "markdown-rule",
      "runtimes": ["claude", "copilot"],
      "items": {
        "self-improve-on-correction.md": {
          "requires": ["skills/self-improve"]
        },
        "compact-governing-docs.md": {
          "requires": ["skills/compact-skill-creator", "skills/compact-docs-writer"]
        },
        "write-realistic-texts.md": {
          "requires": ["skills/use-conversational-language"]
        },
        "no-nonsense-comments.md": {
          "requires": ["skills/use-conversational-language"]
        },
        "write-simple-explanations.md": {
          "requires": ["skills/explain-in-simple-language"]
        }
      }
    },
    {
      "type": "skills",
      "path": "skills",
      "items": {
        "compact-skill-creator": {
          "requires": ["skills/compact-docs-writer"]
        },
        "self-improve": {
          "requires": ["skills/compact-skill-creator", "skills/compact-docs-writer"]
        },
        "memory-doctor": {
          "requires": ["skills/self-improve"]
        },
        "review-ticket": {
          "requires": ["skills/fetch-ticket", "skills/use-conversational-language"]
        },
        "refine-pr-review": {
          "requires": ["skills/refine-ticket", "skills/use-conversational-language"]
        },
        "review-code-assistant": {
          "requires": ["skills/use-conversational-language"]
        },
        "maintainer-review": {
          "requires": [
            "skills/review-code-assistant",
            "skills/fresh-eyes-review",
            "skills/use-conversational-language"
          ]
        },
        "check-ticket-implementation": {
          "requires": ["skills/fetch-ticket"]
        },
        "handover": {
          "requires": ["skills/use-conversational-language"]
        },
        "self-review": {
          "requires": ["skills/fresh-eyes-review"]
        }
      }
    }
  ]
}
